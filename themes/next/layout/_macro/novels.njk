{% macro cover(book, number) %}
  <div class="novel-cover novel-cover--{{ book.palette | escape }}" aria-hidden="true">
    {% if book.cover %}<img src="{{ url_for(book.cover) | escape }}" alt="" loading="lazy">{% endif %}
    <span class="novel-cover-number">{{ number }}</span>
    <span class="novel-cover-orbit"></span>
    <span class="novel-cover-title">{{ book.title | escape }}</span>
    <span class="novel-cover-author">{{ book.author | escape }} / 著</span>
  </div>
{% endmacro %}

{% macro state() %}
  <div hidden data-novel-catalogue="{{ novel_client_data() | escape }}"></div>
{% endmacro %}

{% macro contents(book, activePath) %}
  {% for volume in book.volumes %}
    <section class="novel-volume">
      <h3>{{ volume.title | escape }} <span>{{ volume.chapters.length }} 章</span></h3>
      <ol class="novel-chapter-list">
        {% for chapter in volume.chapters %}
          <li{% if chapter.path === activePath %} class="is-current"{% endif %}>
            <a href="{{ url_for(chapter.path) | escape }}"{% if chapter.path === activePath %} aria-current="page"{% endif %}>
              <span class="novel-chapter-order">{{ chapter.order }}</span>
              <span>{{ chapter.title | escape }}</span>
              <span class="novel-chapter-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        {% endfor %}
      </ol>
    </section>
  {% else %}
    <p class="novel-empty">故事尚未开篇，下一次相见时再来看看。</p>
  {% endfor %}
{% endmacro %}
